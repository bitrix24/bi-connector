{
    auto_https off
    admin off
}

:80 {
    root * /app/public

    # Serve static files (images, css, js, etc.) directly
    @static {
        path *.ico *.css *.js *.gif *.jpg *.jpeg *.png *.svg *.webp *.woff *.woff2 *.ttf *.eot
    }
    handle @static {
        file_server
    }

    # Handle PHP files directly
    @phpFiles {
        path *.php
    }
    handle @phpFiles {
        php
    }

    # For all other requests, try file first, then rewrite to index.php
    handle {
        @notFile {
            not file
        }
        rewrite @notFile /index.php
        php
    }

    # Security headers
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        X-XSS-Protection "1; mode=block"
    }

    # Logging
    log {
        output file /var/log/access.log
        format json
    }

    # Error handling
    handle_errors {
        respond "Error {http.error.status_code}: {http.error.status_text}"
    }
}
