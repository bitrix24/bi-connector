# Application Configuration
APP_DOMAIN=https://your-domain.com
APP_ENV=development

# Logging Configuration
LOG_LEVEL=DEBUG
LOG_PATH=/var/log
LOG_ROTATION_DAYS=7

# Cache Configuration
CACHE_TTL_TABLE_LIST=3600
CACHE_TTL_TABLE_DESCRIPTION=3600

# Database Connection Timeouts (seconds)
DB_CONNECTION_TIMEOUT=30

# Age at which a response file left behind by a stopped request is removed, seconds; 0 switches the sweep off
ROWS_FILE_MAX_AGE_SECONDS=3600

# ClickHouse Read Boundaries
# Upper bound the application puts on the row limit of a request
CLICKHOUSE_MAX_RESULT_ROWS=1000000
# Upper bound on the number of rows the source reads for a single query
CLICKHOUSE_MAX_ROWS_TO_READ=100000000
# Upper bound on the execution time of a single query, seconds
CLICKHOUSE_MAX_EXECUTION_TIME=60
# Upper bound on the length of a single line of the answer, bytes
CLICKHOUSE_MAX_LINE_BYTES=4194304
# Upper bound on the size of the whole answer the application reads, bytes
CLICKHOUSE_MAX_RESPONSE_BYTES=1073741824

# Connector Configuration
MYSQL_CONNECTOR_TITLE="MySQL Database Connector"
MYSQL_CONNECTOR_DESCRIPTION="Connector for MySQL databases with authentication"
POSTGRESQL_CONNECTOR_TITLE="PostgreSQL Database Connector"
POSTGRESQL_CONNECTOR_DESCRIPTION="Connector for PostgreSQL databases with authentication"
CLICKHOUSE_CONNECTOR_TITLE="ClickHouse Database Connector"
CLICKHOUSE_CONNECTOR_DESCRIPTION="Connector for ClickHouse databases with authentication"

# Bitrix24 Application Credentials
BITRIX24_PHP_SDK_APPLICATION_CLIENT_ID=
BITRIX24_PHP_SDK_APPLICATION_CLIENT_SECRET=
BITRIX24_PHP_SDK_APPLICATION_SCOPE=
