# Application Configuration
APP_DOMAIN=https://your-domain.com
APP_ENV=development

# Logging Configuration
LOG_LEVEL=DEBUG
LOG_PATH=/var/log
LOG_ROTATION_DAYS=7

# Cache Configuration
CACHE_TTL_TABLE_LIST=3600
CACHE_TTL_TABLE_DESCRIPTION=3600
# One request out of this many removes the expired entries of the catalogue cache; 0 switches the sweep off
CACHE_PRUNE_PROBABILITY=100

# Database Connection Timeouts (seconds)
DB_CONNECTION_TIMEOUT=30

# Read Boundaries Of Every Connection Type
# Upper bound the application puts on the row limit of a request; a request without a positive limit gets
# this one, so no connection type answers without a bound.
#
# This value forms a pair with the memory_limit of the image (512M, set in the Dockerfile). On the MySQL
# and PostgreSQL paths the driver collects the whole result before the first row is read, so a request
# needs the number of rows multiplied by the width of a row: measured against MySQL 8.4, 500000 rows cost
# about 176 MB at 300 bytes a row and reach 512 MB only at about 950 bytes a row. Raise one of the two and
# the other has to follow, otherwise the row bound stops being a bound on memory and the request ends in a
# fatal error instead of a refusal.
#
# The pair is therefore tuned for rows up to about 900 bytes wide. A table whose rows are wider -- one
# carrying a description, a comment, an address or a JSON column -- needs MAX_RESULT_ROWS lowered here, or
# memory_limit raised in the same proportion. This width has nothing to do with the one
# CLICKHOUSE_EXPECTED_ROW_BYTES below carries: that one bounds the length of an answer of ClickHouse, a
# path that reads the answer line by line and costs the same memory at any number of rows.
MAX_RESULT_ROWS=500000

# Response File Boundaries
# Age at which a response file left behind by a stopped request is removed, seconds; 0 switches the sweep off
ROWS_FILE_MAX_AGE_SECONDS=3600
# Shortest interval between two sweeps of the stale response files, seconds; 0 makes every request sweep
ROWS_FILE_SWEEP_INTERVAL_SECONDS=300
# Upper bound on the size of a response file, bytes
ROWS_FILE_MAX_BYTES=1073741824
# Optional override of the number of rows a response file holds, the row of column names included. Left
# unset it follows MAX_RESULT_ROWS + 1, so the two cannot drift apart; set it only to bound the file below
# the row limit of the application.
# ROWS_FILE_MAX_ROWS=500001

# ClickHouse Read Boundaries
# Upper bound on the number of rows the source reads for a single query
CLICKHOUSE_MAX_ROWS_TO_READ=100000000
# Upper bound on the execution time of a single query, seconds
CLICKHOUSE_MAX_EXECUTION_TIME=60
# Time budget of the availability check, seconds: both the inactivity ceiling and the whole exchange
CLICKHOUSE_CHECK_TIMEOUT_SECONDS=10
# Upper bound on the length of a single line of the answer, bytes
CLICKHOUSE_MAX_LINE_BYTES=4194304
# Expected width of a row; MAX_RESULT_ROWS multiplied by it gives the bound on the whole answer. This is
# the setting to turn when the answers of the source are wider or narrower than expected. It bounds the
# length of the answer and never the memory of a request, because this path reads the answer line by line;
# the width the memory_limit of the image is paired with is the one described at MAX_RESULT_ROWS above.
CLICKHOUSE_EXPECTED_ROW_BYTES=1024
# Optional override of the bound on the size of the whole answer the application reads, bytes. Left unset
# it follows MAX_RESULT_ROWS multiplied by CLICKHOUSE_EXPECTED_ROW_BYTES, so a change of the row limit
# carries over; a fixed number here keeps the old value after such a change.
# CLICKHOUSE_MAX_RESPONSE_BYTES=536870912

# Connector Configuration
MYSQL_CONNECTOR_TITLE="MySQL Database Connector"
MYSQL_CONNECTOR_DESCRIPTION="Connector for MySQL databases with authentication"
POSTGRESQL_CONNECTOR_TITLE="PostgreSQL Database Connector"
POSTGRESQL_CONNECTOR_DESCRIPTION="Connector for PostgreSQL databases with authentication"
CLICKHOUSE_CONNECTOR_TITLE="ClickHouse Database Connector"
CLICKHOUSE_CONNECTOR_DESCRIPTION="Connector for ClickHouse databases with authentication"

# Bitrix24 Application Credentials
BITRIX24_PHP_SDK_APPLICATION_CLIENT_ID=
BITRIX24_PHP_SDK_APPLICATION_CLIENT_SECRET=
BITRIX24_PHP_SDK_APPLICATION_SCOPE=
